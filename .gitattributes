# Большие бинарные исходники — через Git LFS (один раз: git lfs install)
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.kra   filter=lfs diff=lfs merge=lfs -text

# Код и конфиги — всегда LF (StyLua проверяет line_endings = "Unix")
*.luau text eol=lf
*.lua  text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.csv  text eol=lf
